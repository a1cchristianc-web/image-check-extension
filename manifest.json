{
  "manifest_version": 3,
  "name": "Image Check: privacy & authenticity",
  "version": "0.1.0",
  "description": "Right-click any image to see trackers, hidden personal data, tampering and provenance signals. Analysis runs on your device.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Image Check",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
